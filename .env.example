QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
COLLECTION=travel_notes
TOP_K=8
ROOT_DATA_DIR=/absolute/path/to/vacations

# Default local answer generation through Ollama:
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
FORMATTER_PROVIDER=ollama
FORMATTER_MODEL=gemma3:4b

# OpenAI-compatible answer generation, for example OpenRouter/DeepSeek-compatible API:
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-v4-pro
# FORMATTER_PROVIDER=openai
# FORMATTER_MODEL=deepseek-v4-flash
# OPENAI_BASE_URL=https://example.com/v1
# OPENAI_API_KEY=put-your-api-key-here
